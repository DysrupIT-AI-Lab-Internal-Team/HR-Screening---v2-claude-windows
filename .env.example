# Claude Code model used for screening and generation.
# Leave blank to use Claude Code's default model (recommended for Pro plans).
# Set to a specific model name to override, e.g. claude-sonnet-4-6
CLAUDE_MODEL=

# ── BambooHR Resume Downloader (Main Menu -> Download Resume) ──
# Required only if you use the Download Resume feature.
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=
# Where downloaded resumes are saved (organized as "<id> - <title>/<stage>/").
DOWNLOAD_DIR=./resume_downloads
# Seconds to wait between BambooHR API calls (rate-limit friendly).
API_DELAY_SECONDS=2.0
